---
const education = [
  {
    title: 'Máster en Arquitectura de Software',
    institution: 'MIT Professional Education',
    year: '2023',
    details: 'Especialización en sistemas distribuidos de alta disponibilidad y escalabilidad masiva.'
  },
  {
    title: 'Grado en Ingeniería Informática',
    institution: 'UPM Madrid',
    year: '2019',
    details: 'Graduado con mención de honor en Inteligencia Artificial y Algoritmia.'
  }
];

const certifications = [
  { title: 'AWS Solutions Architect', issuer: 'Amazon Web Services', status: 'Expert' },
  { title: 'Google Professional Cloud Developer', issuer: 'Google Cloud', status: 'Professional' },
  { title: 'Certified Kubernetes Administrator', issuer: 'CNCF', status: 'Core' }
];
---

<section id="formacion" class="py-40 px-6 dark:bg-[#070708]">
  <div class="max-w-6xl mx-auto grid lg:grid-cols-2 gap-24 items-start">
    <div>
      <h2 class="text-indigo-600 dark:text-indigo-400 font-bold tracking-widest uppercase text-sm mb-6">Formación</h2>
      <h3 class="text-4xl md:text-5xl font-black mb-16 dark:text-white">Academia & especialización</h3>
      <div class="space-y-16">
        {education.map(edu => (
          <div class="relative pl-10 border-l border-indigo-500/20 group">
            <div class="absolute left-[-5px] top-0 w-2.5 h-2.5 bg-indigo-500 rounded-full group-hover:scale-150 transition-transform"></div>
            <h3 class="text-2xl font-black mb-2 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors uppercase tracking-tight">{edu.title}</h3>
            <p class="text-indigo-600 dark:text-indigo-400 font-bold mb-4">{edu.institution} <span class="mx-2 opacity-30">|</span> {edu.year}</p>
            <p class="text-gray-500 dark:text-gray-400 text-lg leading-relaxed font-light">{edu.details}</p>
          </div>
        ))}
      </div>
    </div>
    
    <div>
      <h2 class="text-indigo-600 dark:text-indigo-400 font-bold tracking-widest uppercase text-sm mb-6 text-right">Acreditaciones</h2>
      <h3 class="text-4xl md:text-5xl font-black mb-16 dark:text-white text-right">Logros validados</h3>
      <div class="space-y-6">
        {certifications.map(cert => (
          <div class="p-8 bg-white dark:bg-white/5 border border-gray-100 dark:border-white/10 rounded-[2rem] flex items-center justify-between hover:border-indigo-500 dark:hover:border-indigo-500/50 transition-all group">
            <div>
              <h4 class="text-xl font-black group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors dark:text-gray-200">{cert.title}</h4>
              <p class="text-gray-400 font-medium">{cert.issuer}</p>
            </div>
            <span class="text-xs font-black px-4 py-1 bg-gray-50 dark:bg-white/10 rounded-full dark:text-gray-500 uppercase tracking-widest">{cert.status}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
