---
import ThemeToggle from './ThemeToggle.astro';

const navItems = [
  { name: 'Inicio', href: '#inicio' },
  { name: 'Sobre mí', href: '#sobre-mi' },
  { name: 'Tecnologías', href: '#tech-stack' },
  { name: 'Proyectos', href: '#proyectos' },
  { name: 'Experiencia', href: '#experiencia' },
  { name: 'Contacto', href: '#contacto' },
];
---

<header class="fixed top-0 left-0 w-full z-50 bg-white/80 backdrop-blur-md border-b border-gray-100 dark:bg-black/80 dark:border-white/10">
  <div class="max-w-6xl mx-auto px-6 h-20 flex items-center justify-between">
    <a href="#inicio" class="text-xl font-bold tracking-tighter hover:opacity-70 transition-opacity dark:text-white">
      PORTAFOLIO.
    </a>
    
    <nav class="hidden md:flex items-center gap-8">
      {navItems.map(item => (
        <a 
          href={item.href} 
          class="text-sm font-medium text-gray-600 hover:text-black transition-colors dark:text-gray-400 dark:hover:text-white"
        >
          {item.name}
        </a>
      ))}
      <div class="flex items-center gap-4">
        <ThemeToggle />
        <a 
          href="/cv-cjran.pdf" 
          download
          class="bg-black text-white px-5 py-2.5 rounded-full text-sm font-medium hover:bg-gray-800 transition-all active:scale-95 dark:bg-white dark:text-black dark:hover:bg-gray-200"
        >
          CV
        </a>
      </div>
    </nav>
    
    <!-- Mobile Menu Button (Simple) -->
    <button class="md:hidden p-2" aria-label="Menu">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
      </svg>
    </button>
  </div>
</header>
