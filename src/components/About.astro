---
import { personalData } from '../config';
---

<section id="sobre-mi" class="py-40 px-6 relative">
  <div class="max-w-6xl mx-auto">
    <div class="grid lg:grid-cols-12 gap-20 items-center">
      <div class="lg:col-span-5 relative">
        <div class="aspect-[4/5] bg-gradient-to-tr from-indigo-100 to-purple-100 dark:from-white/5 dark:to-white/10 rounded-[2.5rem] overflow-hidden border border-gray-200 dark:border-white/10 shadow-2xl rotate-2 hover:rotate-0 transition-transform duration-700 group">
             <img 
               src={personalData.profileImage} 
               alt={personalData.name} 
               class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
             />
             <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
        </div>
        <!-- Decorative elements -->
        <div class="absolute -bottom-10 -left-10 w-32 h-32 bg-indigo-500 rounded-3xl -z-10 rotate-12 blur-2xl opacity-20"></div>
      </div>

      <div class="lg:col-span-7">
        <h2 class="text-indigo-600 dark:text-indigo-400 font-bold tracking-widest uppercase text-sm mb-8">Estrategia & Visión</h2>
        <h3 class="text-5xl md:text-6xl font-black mb-10 leading-[1.1] dark:text-white">
          Ingeniería de software con enfoque en <span class="text-indigo-600">resultados</span>.
        </h3>
        <div class="space-y-8 text-gray-500 dark:text-gray-400 text-xl font-light leading-relaxed">
          <p>
            {personalData.bio}
          </p>
          <p>
            Con amplia experiencia en arquitecturas de frontend modernas y servicios distribuidos, he liderado equipos para entregar productos que han impactado positivamente en la retención de usuarios y la eficiencia operativa.
          </p>
          <div class="pt-6 grid grid-cols-2 gap-8 border-t border-gray-100 dark:border-white/5">
             <div>
                <span class="block text-4xl font-black text-black dark:text-white mb-2">+5 Años</span>
                <span class="text-sm uppercase tracking-widest font-bold">Experiencia</span>
             </div>
             <div>
                <span class="block text-4xl font-black text-black dark:text-white mb-2">+20</span>
                <span class="text-sm uppercase tracking-widest font-bold">Proyectos Éxito</span>
             </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
